<!-- START data.dot.viz import code -->
<!-- Code for all browsers-->
<script>
    // Cross-browser init functions
    function dataDotVizInitCharts() {
        // Init charts from embedded HTML config
        window.dataDotViz.renderCharts(
            window.dataDotViz.defaultEngineConfig,
            document.body
        );

        const regionConfig = [
            ["Africa","المنطقة الأفريقية","Région africaine","Región Africana","Африканский регион","非洲地区","953"],
            ["Americas","منطقة الأمريكتين","Région des Amériques","Región de las Américas","Регион Америки","美洲地区","954"],
            ["South East Asia", "منطقة جنوب شرق آسيا","Région Asie du Sud-Est","Región de Asia Sudoriental","Регион юго-восточной Азии","东南亚区域","955"],
            ["Europe","المنطقة الأوروبية","Région européenne","Región Europea","Европейский регион","欧洲地区","956"],
            ["Eastern Mediterranean","منطقة شرق البحر الأبيض المتوسط","Région de la Méditerranée orientale","Región del Mediterráneo Oriental","Регион Восточного Средиземноморья","东地中海区域","957"],
            ["Western Pacific","منطقة غرب المحيط الهادئ","Région du Pacifique occidental","Región del Pacífico Occidental","Западно-Тихоокеанский регион","西太平洋地区","958"]
        ];
        const countryInfoTable = document.querySelector('[aria-labelledby="country-name"]');
        let regionM49Code = '001';
        if (countryInfoTable !== null) {
            const whoRegionTr = countryInfoTable.querySelector('tr:nth-child(3)');
            const whoRegion = whoRegionTr.querySelector('td').innerHTML;
            regionConfig.forEach((rc) => {
                rc.forEach((r) => {
                    if (r === whoRegion) {
                        regionM49Code = rc[6];
                    }
                });
            });
        }

        // Init charts from embedded JSON config
        Array.prototype.slice
            .call(document.querySelectorAll('.dataDotViz-jsonChartConfig'))
            .forEach(
                function(element) {
                    var json = element.getAttribute('data-data-dot-viz-json-config');
                    if (!json) return;
                    var config;
                    try {
                        config = JSON.parse(json);
                        config.dimensions.forEach((d) => {
                            if (d.type === 'COUNTRY' && d.value === '%%REGION_M49_CODE%%') {
                                d.value = regionM49Code;
                            }
                        });
                    } catch (error) {
                        console.error('Could not parse chart config:', json);
                        return;
                    }
                    window.dataDotViz.renderChartFromConfig(
                        window.dataDotViz.defaultEngineConfig,
                        element,
                        config
                    );
                    element.classList.remove('dataDotViz-jsonChartConfig');
                }
            );
    }

    function dataDotVizInitWidgets() {
        dataDotVizInitCountryPageWidgets();

        var element = document.getElementById('data-visualization');
        if (!element) return;
        var elementDataSet = element.dataset;
        var dataWidgetConfig = elementDataSet.widgetConfig,
            dataWidgetConfigOverride = elementDataSet.widgetConfigOverride,
            dataWidgetType = elementDataSet.widgetType,
            config = {
                element: element
            };
        if (typeof dataWidgetConfig === 'undefined') {
            return;
        }
        if (typeof dataWidgetConfigOverride !== 'undefined') {
            config = Object.assign(config, JSON.parse(dataWidgetConfig), JSON.parse(dataWidgetConfigOverride));
        } else {
            config = Object.assign(config, JSON.parse(dataWidgetConfig));
        }

        if (dataWidgetType === 'country-explorer') {
            // Country explorer configuration
            window.dataDotVizWidgets.renderSimpleIndicatorCountryExplorer(config);
            return;
        }
        // Category explorer configuration
        window.dataDotVizWidgets.renderCategoryExplorer(config);
    }

    function dataDotVizInitCountryPageWidgets() {
        const m49CodeElement = document.querySelector('[data-m49-code]');
        const m49Code = m49CodeElement ? m49CodeElement.getAttribute('data-m49-code') : '004';
        const iso3CodeElement = document.querySelector('[data-iso3-code]');
        const iso3Code = m49CodeElement ? m49CodeElement.getAttribute('data-iso3-code') : 'AFG';
        const dimensions = [
          // ghecausesofdeath expects ISO3 codes
          { dim: 'spatial', type: 'COUNTRY', value: iso3Code },
          // Infectious and parasitic diseases
          { dim: 'disaggregating', type: 'DIM_GHECAUSE_CODE', value: '20' },
          { dim: 'disaggregating', type: 'DIM_SEX_CODE', value: 'BTSX' },
          { dim: 'disaggregating', type: 'DIM_AGEGROUP_CODE', value: 'ALLAges' },
        ];

        const $lifeExpectancyOverview = document.getElementById('life-expectancy-overview');
        if ($lifeExpectancyOverview) {
            window.dataDotVizWidgets.renderLifeExpectancyOverview({
                element: $lifeExpectancyOverview,
                m49Code: m49Code
            });
        }

        const $multipleEpi = document.getElementById('multiple-epi');
        if ($multipleEpi) {
            const lang = document.querySelector('html').getAttribute('lang');
            let title = 'Deaths per 100\u202F000 populations';
            if (lang === 'ar') {
                title = 'الوفيات لكل 100 000 نسمة';
            } else if (lang === 'fr') {
                title = 'Décès pour 100 000 habitants';
            } else if (lang === 'es') {
                title = 'Muertes por 100 000 habitantes';
            } else if (lang === 'ru') {
                title = 'Смертей на 100 000 населения';
            } else if (lang === 'zh') {
                title = '每10万人的死亡人数';
            }
            window.dataDotVizWidgets.renderMultipleEpi({
                element: $multipleEpi,
                showSeparator: true,
                titles: [title],
                  configs: [
                    {
                      type: 'epi',
                      dataSource: 'ghecausesofdeath',
                      dataSourceFlags: ['unrankable'],
                      indicator: 'VAL_DEATHS_RATE100K_NUMERIC',
                      dimensions,
                      topCausesTableMaxRows: 1000,
                      epiMarkType: 'line',
                    },
                    {
                      type: 'epi',
                      dataSource: 'ghecausesofdeath',
                      dataSourceFlags: ['unrankable'],
                      indicator: 'VAL_DALY_RATE100K_NUMERIC',
                      dimensions,
                      topCausesTableMaxRows: 1000,
                      epiMarkType: 'line',
                    },
                    {
                      type: 'epi',
                      dataSource: 'ghecausesofdeath',
                      dataSourceFlags: ['unrankable'],
                      indicator: 'VAL_YLL_RATE100K_NUMERIC',
                      dimensions,
                      topCausesTableMaxRows: 1000,
                      epiMarkType: 'line',
                    },
                    {
                      type: 'epi',
                      dataSource: 'ghecausesofdeath',
                      dataSourceFlags: ['unrankable'],
                      indicator: 'VAL_YLD_RATE100K_NUMERIC',
                      dimensions,
                      topCausesTableMaxRows: 1000,
                      epiMarkType: 'line',
                    },
                  ],
            });
        }
    }

    function dataDotVizInitLegacy() {
        System.import(dataDotVizWidgetsLegacySrc).then(dataDotVizInitWidgets);
        System.import(dataDotVizChartsLegacySrc).then(dataDotVizInitCharts);
    }

    function dataDotVizLoadLegacyPolyfill() {
        if (window.System) {
            dataDotVizInitLegacy();
        } else if (!window.dataDotVizIsLoadingLegacyPolyfill) {
            window.dataDotVizIsLoadingLegacyPolyfill = true;
            var script = document.createElement('script');
            script.src = dataDotVizLegacyPolyfillSrc;
            script.onload = dataDotVizInitLegacy;
            document.body.appendChild(script);
        }
    }
</script>
<!-- ESM -->
<script type="module">
    // Use dynamic import. This causes a syntax error in browsers that don't, stopping the script.
    import(dataDotVizChartsSrc).then(dataDotVizInitCharts);
    import(dataDotVizWidgetsSrc).then(dataDotVizInitWidgets);
    window.dataDotVizDynamicImportSupported = true;
</script>
<!--
  Fall back to legacy build when dynamic import is unsupported
  (Chrome 61-62, Firefox 60-66, Edge 16-78 and Safari 10.3-11.0).
-->
<script type="module">
    if (!window.dataDotVizDynamicImportSupported) {
        dataDotVizLoadLegacyPolyfill();
    }
</script>
<!-- Non-ESM -->
<script nomodule>
    dataDotVizLoadLegacyPolyfill();
</script>
<!-- END data.dot.viz import code -->
<script type="text/javascript">
window.addEventListener('load', () => {
      window.matchMedia("print").addEventListener("change", evt => {
        if (evt.matches) {
          elms = document.body.querySelectorAll("details:not([open])");
          for (e of elms) {
            e.setAttribute("open", "");
            e.dataset.wasclosed = "";
            e.style.backgroundColor = "#ccc !important";
          }
        } else {
          elms = document.body.querySelectorAll("details[data-wasclosed]");
          for (e of elms) {
            e.removeAttribute("open");
            delete e.dataset.wasclosed;
            e.style.backgroundColor = "";
          }
        }
      })
    })
</script>


