(function () {
    var lang = document.documentElement.lang;
    var link = document.querySelector('.btn-backlink');
    if (link && link.href) {
        var url = new URL(window.location.href);
        var newPath;
        var prefix = url.pathname.includes('/datadot/') ? '/datadot' : '';
        switch (lang) {
            case 'es':
                newPath = prefix + '/es/countries/';
                break;
            case 'fr':
                newPath = prefix + '/fr/countries/';
                break;
            case 'ru':
                newPath = prefix + '/ru/countries/';
                break;
            case 'zh':
                newPath = prefix + '/zh/countries/';
                break;
            case 'ar':
                newPath = prefix + '/ar/countries/';
                break;
            default:
                newPath = prefix + '/countries/';
                break;
        }
        var newUrl = new URL(newPath, url.protocol + "//" + url.host);
        link.href = newUrl.toString();
    }
})();
</script><script type="text/javascript">
