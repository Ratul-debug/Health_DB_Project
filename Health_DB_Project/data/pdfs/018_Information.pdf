(function () {
    // Add M49 code to the URL of the health statistics pages #3268
    const countryPage = document.querySelector('.country-pages[data-m49-code]');
    if (countryPage !== null) {
        const m49Code = countryPage.getAttribute('data-m49-code');
        if (m49Code !== null) {
            const healthStatisticsSection = document.querySelector('.health-statistics-section');
            if (healthStatisticsSection !== null) {
                const indicatorLinks = healthStatisticsSection.querySelectorAll('.progressive-tabs-tabpanel footer a:first-child');
                if (indicatorLinks.length > 0) {
                    for (const element of indicatorLinks) {
                        element.href += '?m49=' + m49Code;
                    }
                }
            }
                      // m49 appending in emergency dashboard #3291
            const emergencyDashboardSection = document.querySelector('.emergency-dashboards-section');
            if (emergencyDashboardSection !== null) {
                const links = emergencyDashboardSection.querySelectorAll('.list-menu a');
                if (links.length > 0) {
                    for (const link of links) {
                        if (link.href.indexOf('covid19') !== -1) {
                            link.href += '?m49=' + m49Code;
                        }
                    }
                }
            }
        }
    }

    // Center text charts #3262
    const allCharts = document.querySelectorAll('.chart > div');
    if (allCharts.length > 0) {
        for (const chart of allCharts) {
            const dataDataDotVizJsonConfig = chart.getAttribute('data-data-dot-viz-json-config');
            if (dataDataDotVizJsonConfig !== null && dataDataDotVizJsonConfig.indexOf('populationProjectionText') !== -1) {
                chart.classList.add('chart-vertical-center');
            }
        }
    }

    // Replace %%COUNTRY%% with the country name in the emergency dashboards #3259
    const countryName = document.querySelector('#country-name');
    if (countryName !== null) {
        const emergencyDashboard = document.querySelector('.emergency-dashboards-section');
        if (emergencyDashboard !== null) {
            const emergencyDashboardLinks = emergencyDashboard.querySelectorAll('a');
            if (emergencyDashboardLinks.length > 0) {
                for (const links of emergencyDashboardLinks) {
                    if (links.innerText.indexOf('%%COUNTRY%%') !== -1) {
                        links.innerText = links.innerText.replace('%%COUNTRY%%', countryName.innerText);
                    }
                }
            }
        }
    }

    // 3B Chart group container alignment #3263
    let resizeTimeout;
    window.addEventListener('resize', resizeEventHandler);
    alignChartHeaders();

    function resizeEventHandler() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(alignChartHeaders, 300);
    }
    
    function alignChartHeaders() {
        let MIN_WIDTH = 1920;
        let currentWidth = window.innerWidth;
        if (currentWidth < MIN_WIDTH) {
            return;
        }

        const HealthTargetProcessSection = document.querySelector('.health-target-progress-section');
        if (HealthTargetProcessSection !== null) {
            const chartHeaders = HealthTargetProcessSection.querySelectorAll('.chart header');
            if (chartHeaders.length > 0) {
                let height = -1;
                for (const chartHeader of chartHeaders) {
                    if (height < chartHeader.offsetHeight) {
                        height = chartHeader.offsetHeight;
                    }
                }

                if (height > -1) {
                    const style = document.createElement("style");
                    style.textContent = "@media (min-width: 1920px) { .health-target-progress-section .chart header { min-height: " + height + "px; } }";
                    document.head.appendChild(style);

                    // remove event handler
                    window.removeEventListener('resize', resizeEventHandler);
                }
            }
        }
    }

    // Charting style issues #3295
    const allCharts2 = document.querySelectorAll('.chart > div');
    if (allCharts2.length > 0) {
        for (const chart of allCharts2) {
            chart.classList.add('dataDotViz-theme');
            chart.classList.add('dataDotViz-theme-light');

            const dataDataDotVizJsonConfig = chart.getAttribute('data-data-dot-viz-json-config');
            if (dataDataDotVizJsonConfig !== null && dataDataDotVizJsonConfig.indexOf('factoid') !== -1) {
                chart.removeAttribute('style');
            }
        }
    }
})();

</script><script type="text/javascript">
